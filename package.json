{
  "name": "pi-md-preview",
  "version": "0.1.0",
  "description": "High-fidelity, editor-agnostic browser preview for Markdown and LaTeX",
  "type": "module",
  "private": true,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "types": "./dist/index.d.ts",
  "bin": {
    "pi-md-preview": "./dist/cli.js"
  },
  "files": [
    "dist",
    "docs/screenshots",
    "LICENSE",
    "README.md"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --import tsx --test --test-concurrency=1 test/*.test.ts"
  },
  "keywords": [
    "markdown",
    "latex",
    "pandoc",
    "preview",
    "cli"
  ],
  "license": "MIT",
  "dependencies": {
    "chokidar": "^4.0.3"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "tsx": "^4.20.0",
    "typescript": "^5.8.0"
  }
}
